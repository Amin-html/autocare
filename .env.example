# Скопируйте в .env и заполните. Файл .env в git не попадает (см. .gitignore).
POSTGRES_PASSWORD=autocare_local
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=замените-на-случайную-строку
# true — при старте создаст демо-аккаунты и тестовые записи (только если база пуста)
SEED_DEMO_DATA=true
